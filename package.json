{
  "name": "nova-trade",
  "version": "1.2.0",
  "description": "NovaTrade - AI加密货币智能分析平台",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "NovaTrade",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "electron-updater": "^6.8.10"
  },
  "build": {
    "appId": "com.novatrade.app",
    "productName": "NovaTrade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/*.js",
      "renderer/index.html",
      "renderer/app.js",
      "renderer/settings.js",
      "renderer/radar.js",
      "renderer/fills-view.js",
      "renderer/lib/*.js",
      "renderer/widget.html",
      "renderer/widget.js",
      "renderer/lightweight-charts.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaTrade",
      "deleteAppDataOnUninstall": false,
      "license": null,
      "warningsAsErrors": false,
      "include": "installer.nsh"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "121012445",
        "repo": "NovaTrade",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
